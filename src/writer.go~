// 		panic(err)
// 	}
// 	return val
// }

var validators map[string]validator = map[string]validator{
	"max": {
		imports:   []string{},
		converter: ValToInt,
	},
	"min": {
		imports:   []string{},
		converter: ValToInt,
	},
	"minLen": {
		imports:   []string{},
		converter: ValToInt,
	},
	"maxLen": {
		imports:   []string{},
		converter: ValToInt,
	},
	"email": {
	imports: []string{ MAIL }, 
}
}

var intValidators []string = []string{"max", "min", "minLen", "maxLen"}

// var stringValidators []string = []string{"regex"}

var simpleValidators []string = []string{"email"}

var stringSliceValidators []string = []string{"option"}

func NewTemplateWriter(vSpec *ValidatorSpec, field *Field) *TemplateWriter {

	var data any

	if slices.Contains(intValidators, vSpec.Name) {
		data = util.AnyToInt(vSpec.Value, "value for "+vSpec.Name+" must be an int")
	} else if slices.Contains(stringSliceValidators, vSpec.Name) {
		data = util.AnyToStrSlice(vSpec.Value)
		field.Obj.imports.Add(SLICES)
	} else if !slices.Contains(simpleValidators, vSpec.Name) {
		panic("no validator named " + vSpec.Name)
	}

	switch vSpec.Name {
	case "email":
		// import net/mail
		field.Obj.imports.Add(MAIL)
	}

	return &TemplateWriter{
		ValidatorSpec: vSpec,
		Field:         field,
		Value:         data,
	}
}

func (t *TemplateWriter) errTemplateName() string {
	return t.ValidatorSpec.Name + "_err"
}

func (t *TemplateWriter) WriteOuter() {
	err := templates.Tmpl.ExecuteTemplate(t.Field.Obj.builder, t.errTemplateName(), t)
	util.PanicIf(err)
}

func (t *TemplateWriter) WriteValidation() {
	err := templates.Tmpl.ExecuteTemplate(t.Field.Obj.builder, t.ValidatorSpec.Name, t)
	util.PanicIf(err)
}
